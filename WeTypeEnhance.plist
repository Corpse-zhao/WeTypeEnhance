<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  过滤规则直接照抄同目录下已验证可用的「微信输入法-毛玻璃效果 1.2.6」：
      Bundles = com.tencent.wetype.keyboard / com.tencent.xin.keyboard / com.tencent.wetype
      Executables = wxkb_plugin / wxkb_plugin.appex
  该组合在微信输入法 3.5.0 上实测可注入键盘扩展。
-->
<plist version="1.0">
<dict>
    <key>Filter</key>
    <dict>
        <!-- v1.9.1：把宿主 App 覆盖面一次性铺开。
             第三方键盘真正的显示位置在宿主 App 进程里：
                 UIRemoteKeyboardWindow → UIInputSetContainerView → UIInputSetHostView
             系统在那几级容器上垫的键盘底板，扩展进程无论怎么清都碰不到。

             Classes = UIInputSetHostView：这是「会弹键盘的宿主」的精确特征。
             关键点：它是 UIKitCore 里的一个**类**，任何链接了 UIKit 的进程
             （包括键盘扩展自己）都注册了它 —— 过滤器判的是「类存在」不是「实例存在」。
             所以：
               · 若 Mode 默认/显式是 Any（或）→ Bundles 命中 或 Classes 命中即注入，
                 等于「所有能弹键盘的 App」都注入，不用穷举包名；
               · 就算某个实现把 Mode 当 All（与）→ 交集恰好还是 Bundles 那一批，
                 行为与 v1.8.8 完全一致，**不会变得更差**。
             两种语义下键盘扩展本身都一定被注入，安全。 -->
        <key>Mode</key>
        <string>Any</string>
        <key>Bundles</key>
        <array>
            <!-- 键盘扩展本体：主体逻辑在这里 -->
            <string>com.tencent.wetype.keyboard</string>
            <string>com.tencent.xin.keyboard</string>
            <string>com.tencent.wetype</string>
            <!-- 阳性对照 + 偏好中继 -->
            <string>com.apple.springboard</string>
            <!-- 宿主 App：键盘窗口就在这些进程里，透明底必须靠它们 -->
            <string>com.tencent.xin</string>
            <string>com.tencent.wework</string>
            <string>com.tencent.mqq</string>
            <string>com.tencent.mobileqq</string>
            <string>com.apple.mobilesafari</string>
            <string>com.apple.Preferences</string>
            <string>com.apple.mobilenotes</string>
            <string>com.apple.MobileSMS</string>
            <string>com.apple.mobilemail</string>
            <string>com.apple.mobilecal</string>
            <string>com.alipay.iphoneclient</string>
            <string>com.taobao.taobao4iphone</string>
            <string>com.taobao.taobao</string>
            <string>com.ss.iphone.ugc.Aweme</string>
            <string>com.xingin.discover</string>
            <string>com.sina.weibo</string>
            <string>com.google.chrome.ios</string>
        </array>
        <key>Classes</key>
        <array>
            <string>UIInputSetHostView</string>
        </array>
        <key>Executables</key>
        <array>
            <string>wxkb_plugin</string>
            <string>wxkb_plugin.appex</string>
        </array>
    </dict>
</dict>
</plist>
