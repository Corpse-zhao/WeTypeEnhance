<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  v1.9.3：把过滤规则退回「只用 Bundles」这一种最稳的写法。

  为什么退回：
  v1.9.1 加了 Mode=Any + Classes=UIInputSetHostView + Executables，本意是把宿主 App
  覆盖面铺开。但不同注入器（ellekit / substrate）对多键组合的语义实现并不一致：
    · Mode=Any 当【或】 → Bundles 或 Classes 或 Executables 命中即注入（我们想要的）
    · 有的实现把多键当【与】 → 必须 Bundles **且** Classes **且** Executables 全命中
      → 宿主 App（com.tencent.xin）没有 Executables=wxkb_plugin → **宿主永远注入失败**
  两种语义下「只用 Bundles」结果完全一样：包名在列表里 = 注入。
  这就消掉了「宿主侧到底有没有被注入」这个最大的未知数。

  注意：键盘扩展 + SpringBoard + 宿主 App 全部写在 Bundles 里，
  缺一个 = 那个进程里什么都不做。
-->
<plist version="1.0">
<dict>
    <key>Filter</key>
    <dict>
        <key>Bundles</key>
        <array>
            <!-- ===== 键盘扩展本体（主体逻辑在这里）===== -->
            <string>com.tencent.wetype.keyboard</string>
            <string>com.tencent.xin.keyboard</string>
            <string>com.tencent.wetype</string>

            <!-- ===== 阳性对照 + 偏好中继 ===== -->
            <string>com.apple.springboard</string>

            <!-- ===== 宿主 App：键盘真正显示的位置在这里，透明底必须靠它们 =====
                 （透明底灰底是宿主那一级 UIInputSetHostView / backdrop 垫的，
                   键盘扩展进程无论怎么清都碰不到） -->
            <string>com.tencent.xin</string>
            <string>com.tencent.wework</string>
            <string>com.tencent.mqq</string>
            <string>com.tencent.mobileqq</string>
            <string>com.tencent.qq</string>
            <string>com.apple.mobilesafari</string>
            <string>com.apple.Preferences</string>
            <string>com.apple.mobilenotes</string>
            <string>com.apple.MobileSMS</string>
            <string>com.apple.mobilemail</string>
            <string>com.apple.mobilecal</string>
            <string>com.apple.AppStore</string>
            <string>com.alipay.iphoneclient</string>
            <string>com.taobao.taobao4iphone</string>
            <string>com.taobao.taobao</string>
            <string>com.ss.iphone.ugc.Aweme</string>
            <string>com.xingin.discover</string>
            <string>com.sina.weibo</string>
            <string>com.google.chrome.ios</string>
            <string>com.apple.mobileslideshow</string>
            <string>com.apple.health</string>
            <string>com.apple.weather</string>
            <string>com.apple.stocks</string>
            <string>com.apple.reminders</string>
            <string>com.apple.facetime</string>
            <string>com.apple.Photos</string>
            <string>com.apple.Files</string>
            <string>com.apple.DocumentsApp</string>
            <string>com.apple.Tips</string>
        </array>
    </dict>
</dict>
</plist>
